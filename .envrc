# shellcheck shell=bash
# Re-evaluate when an authoritative toolchain pin changes.
watch_file .node-version
watch_file .npm-version
watch_file rust-toolchain.toml
watch_file lean/lean-toolchain

export AXIOGRAPH_ROOT="$PWD"

# Keep secrets and machine-local overrides out of the repository.
dotenv_if_exists .env
dotenv_if_exists .env.local
source_env_if_exists .envrc.local

# Project-built commands and frontend tools.
PATH_add "$AXIOGRAPH_ROOT/build/bin"
PATH_add "$AXIOGRAPH_ROOT/build/tools/mdbook"
PATH_add "$AXIOGRAPH_ROOT/frontend/viz/node_modules/.bin"

# Select the exact Rust toolchain even when a system rustc precedes rustup.
rust_version="$(awk -F '"' '/^channel = / { print $2; exit }' rust-toolchain.toml)"
if ! command -v rustup >/dev/null 2>&1; then
  log_error "Axiograph requires rustup and Rust ${rust_version}."
  return 1
fi
rust_cargo="$(rustup which --toolchain "$rust_version" cargo 2>/dev/null)" || {
  log_error "Install the pinned toolchain: rustup toolchain install ${rust_version} --profile minimal --component cargo,clippy,rustfmt"
  return 1
}
PATH_add "$(dirname "$rust_cargo")"
export RUSTUP_TOOLCHAIN="$rust_version"
unset rust_cargo rust_version

# Elan reads this pin even when Lean commands run from the repository root.
if [ -d "$HOME/.elan/bin" ]; then
  PATH_add "$HOME/.elan/bin"
fi
export ELAN_TOOLCHAIN="$(tr -d '[:space:]' < lean/lean-toolchain)"

# Node version managers do not share one activation protocol. Require the
# authoritative .node-version rather than silently using an incompatible Node.
node_version="$(tr -d '[:space:]' < .node-version)"
npm_version="$(tr -d '[:space:]' < .npm-version)"
if ! command -v node >/dev/null 2>&1 || [ "$(node --version)" != "v${node_version}" ]; then
  log_error "Axiograph requires Node.js ${node_version}; install or activate the version in .node-version, then run 'direnv reload'."
  unset node_version npm_version
  return 1
fi
if ! command -v npm >/dev/null 2>&1 || [ "$(npm --version)" != "${npm_version}" ]; then
  log_error "Axiograph requires npm ${npm_version}, bundled with Node.js ${node_version}."
  unset node_version npm_version
  return 1
fi
unset node_version npm_version

log_status "Axiograph environment: Rust $(rustc --version | awk '{print $2}'), Node $(node --version), npm $(npm --version), Lean ${ELAN_TOOLCHAIN#*:}"
