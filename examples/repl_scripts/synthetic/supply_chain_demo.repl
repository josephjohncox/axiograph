# Axiograph REPL script: supply_chain scenario demo
#
# Run (from repo root):
#   make binaries
#   ./bin/axiograph repl --script examples/repl_scripts/synthetic/supply_chain_demo.repl
#
# Or (if installed to PATH):
#   axiograph repl --script examples/repl_scripts/synthetic/supply_chain_demo.repl
#
# Debug via cargo:
#   cd rust && cargo run -p axiograph-cli -- repl --script ../examples/repl_scripts/synthetic/supply_chain_demo.repl

# Generate a supply-chain dataset with alternate routes and explicit path witnesses.
gen supply_chain 3 3 1

stats

# Direct route: supplier → factory.
q select ?f where name("supplier_0") -supplies-> ?f limit 10

# Alternate route: supplier → warehouse → factory.
q select ?f where name("supplier_0") -suppliesVia/transfers-> ?f max_hops 4 limit 10

# Proof-relevant structure: route witnesses between the same endpoints.
q select ?p where ?p is PathWitness, ?p -from-> name("supplier_0") limit 10

# Material capability edges.
q select ?m where name("supplier_0") -suppliesMaterial-> ?m limit 10

# Save the runnable `.axpd` snapshot.
save build/supply_chain.axpd
