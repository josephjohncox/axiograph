# Axiograph REPL script: physics-scale bounded proposal planning walkthrough
#
# Run (from repo root):
#   make binaries
#   ./bin/axiograph repl --script examples/repl_scripts/physics_bounded_proposal_rollout_demo.repl

import_axi examples/physics/PhysicsOntology.axi
import_axi examples/physics/PhysicsMeasurements.axi
# Notes:
# - This script demonstrates the bounded proposal-planning surface in offline
#   mode. The `stub` predictive-proposal backend is deterministic and returns no
#   proposals, so the walkthrough is safe for docs and CI.
# - For an LLM-backed run, replace `proposal use stub` with:
#     proposal use llm
#   and configure one of:
#     export PREDICTIVE_PROPOSAL_BACKEND=openai   export OPENAI_API_KEY=...
#     export PREDICTIVE_PROPOSAL_BACKEND=anthropic export ANTHROPIC_API_KEY=...
#     export PREDICTIVE_PROPOSAL_BACKEND=ollama   (ollama serve)
proposal use stub
proposal plan build/physics_bounded_proposal_rollout_plan.json --steps 2 --rollouts 2 --max 150 --guardrail strict --plane both --goal "expand physics ontology coverage" --axi examples/physics/PhysicsOntology.axi --cq-file examples/competency_questions/physics.cq

# Save the bounded proposal rollout snapshot for inspection.
