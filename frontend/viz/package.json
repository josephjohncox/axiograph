{
  "name": "axiograph-viz",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.context.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "build:debug": "npm run typecheck && vite build --mode debug",
    "preview": "vite preview"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
